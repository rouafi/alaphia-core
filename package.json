{
  "name": "alaphia-core",
  "private": true,
  "workspaces": [
    "front",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace front run dev",
    "build": "npm --workspace front run build",
    "start": "npm --workspace front run start",
    "lint": "npm --workspace front run lint || true",
    "compose:up": "docker compose up -d db front",
    "compose:up:all": "docker compose --profile backend up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=200"
  },
  "dependencies": {
    "lightningcss": "^1.30.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.1.17",
    "lightningcss-linux-arm64-gnu": "^1.30.2"
  }
}
